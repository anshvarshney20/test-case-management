PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://tcm_user:tcm_password@localhost:5432/testcase_mgmt
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testcase_mgmt
DB_USER=tcm_user

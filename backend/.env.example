PORT=5000
NODE_ENV=development

# PostgreSQL — prefer DATABASE_URL (works with Supabase)
# Supabase: Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URI on port 6543 for serverless, or direct 5432 for long-running Node
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_SSL=true

# Local fallback (used only when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testcase_mgmt
DB_USER=tcm_user
DB_PASSWORD=tcm_password

# Redis (optional — falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-key-in-production
JWT_EXPIRES_IN=24h

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173
